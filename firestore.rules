rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      match /credentials/{username} {
        allow create: if !exists(/databases/$(database)/documents/credentials/$(username))
                      && request.resource.data.passwordHash is string
                      && request.resource.data.passwordHash.size() == 64;
        allow read: if true;
        allow update, delete: if false;
      }

      match /users/{username} {
        allow read: if true;
        allow write: if request.resource.data.keys().hasOnly(['theme', 'language', 'height', 'destinationWeight'])
                    && (!('theme' in request.resource.data) || request.resource.data.theme in ['light', 'dark'])
                    && (!('language' in request.resource.data) || request.resource.data.language in ['en', 'he'])
                    && (!('height' in request.resource.data) || (request.resource.data.height is number && request.resource.data.height > 0 && request.resource.data.height < 300))
                    && (!('destinationWeight' in request.resource.data) || (request.resource.data.destinationWeight is number && request.resource.data.destinationWeight > 0 && request.resource.data.destinationWeight < 500));
      }

      match /users/{username}/bloodPressureReadings/{readingId} {
        allow create, update: if request.resource.data.systolic is number
                      && request.resource.data.systolic > 0 && request.resource.data.systolic < 400
                      && request.resource.data.diastolic is number
                      && request.resource.data.diastolic > 0 && request.resource.data.diastolic < 400
                      && request.resource.data.heart_rate is number
                      && request.resource.data.heart_rate > 0 && request.resource.data.heart_rate < 400;
        allow read: if true;
        allow delete: if true;
      }

      match /users/{username}/weightReadings/{readingId} {
        allow create, update: if request.resource.data.value is number
                      && request.resource.data.value > 0 && request.resource.data.value < 500;
        allow read: if true;
        allow delete: if true;
      }

      match /users/{username}/runningSessions/{sessionId} {
        allow create, update: if request.resource.data.distance is number
                      && request.resource.data.distance > 0 && request.resource.data.distance < 500
                      && request.resource.data.time is number
                      && request.resource.data.time > 0 && request.resource.data.time < 1440;
        allow read: if true;
        allow delete: if true;
      }

      match /users/{username}/walkingSessions/{sessionId} {
        allow create, update: if request.resource.data.distance is number
                      && request.resource.data.distance > 0 && request.resource.data.distance < 500
                      && request.resource.data.time is number
                      && request.resource.data.time > 0 && request.resource.data.time < 1440;
        allow read: if true;
        allow delete: if true;
      }

      match /users/{username}/pulldownSessions/{sessionId} {
        allow create, update: if request.resource.data.sessions is number
                      && request.resource.data.sessions > 0 && request.resource.data.sessions < 100
                      && request.resource.data.weight is number
                      && request.resource.data.weight > 0 && request.resource.data.weight < 500;
        allow read: if true;
        allow delete: if true;
      }

      match /users/{username}/benchPressSessions/{sessionId} {
        allow create, update: if request.resource.data.sessions is number
                      && request.resource.data.sessions > 0 && request.resource.data.sessions < 100
                      && request.resource.data.weight is number
                      && request.resource.data.weight > 0 && request.resource.data.weight < 500;
        allow read: if true;
        allow delete: if true;
      }

      match /users/{username}/absSessions/{sessionId} {
        allow create, update: if request.resource.data.workoutType is string
                      && request.resource.data.workoutType in ['6 min Abs', '3 sets of abs', 'Other workout'];
        allow read: if true;
        allow delete: if true;
      }

      match /users/{username}/plankSessions/{sessionId} {
        allow create, update: if request.resource.data.seconds is number
                      && request.resource.data.seconds > 0 && request.resource.data.seconds < 3600;
        allow read: if true;
        allow delete: if true;
      }

      match /users/{username}/pilatesSessions/{sessionId} {
        allow create, update: if request.resource.data.done is bool;
        allow read: if true;
        allow delete: if true;
      }
    }
  }
